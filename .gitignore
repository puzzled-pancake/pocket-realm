# ===== Build outputs =====
# Gradle / Android
**/build/
.local.properties
*.apk
*.aab
*.ap_
*.dex
.cxx/
.gradle/

# Native (CMake/NDK)
build/
*.o
*.obj
*.so
*.a
*.dylib
cmake-build-*/
native/*/build/
native/.deps/
native/.build-*/
native/.smoke-stage-*/
native/.o4-stage-*/
native/.o4-*.so
native/.o04-*.log
native/.x86_64-*.log
native/.build.log
output/

# O06 provider caches (populated by tools/fetch_provider.py; large prebuilt
# archives + extracted trees, hash-verified, never committed).
native/.providers/
native/.providers-extracted/
runtime/glibc-rootfs-x86_64/
runtime/wine-x86/

# ZCode local session data
.zcode/

# Kotlin / Java
*.class
hs_err_pid*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Rust
target/
**/Cargo.lock
# (Cargo.lock is committed for connected binaries later; ignore until then)

# ===== IDE / OS =====
.idea/
*.iml
.vscode/
*.swp
.DS_Store
Thumbs.db

# ===== Proprietary / user-supplied client data — NEVER commit =====
# Per DECISIONS.md #1 and PLAN.md: no proprietary WoW executables, MPQs, DBCs,
# maps, models, textures, or copyrighted addon assets enter source control.
client_import/
**/WoW*.exe
**/*.mpq
**/*.MPQ
**/*.dbc
*.adt
*.wdt
*.m2
*.blp
*.wmo
extracted_data/
data_packs/
generations/content/
generations/runtime/
generations/prefix/

# ===== Runtime state (never commit live realm data) =====
*.db
*.db-wal
*.db-shm
realm_data/
backups/
generations/realm/
*.sqlite
*.sqlite3

# ===== Diagnostics / logs =====
logs/
*.log
support_bundle/
diagnostics/

# Exception: checked-in AVD experiment evidence (PKG-01/02/06 logcat captures,
# per tests/avd/*/pkg-experiments.md and ADR-013). These .log/.logcat files are
# the auditable artifacts the acceptance criteria require, not throwaway logs.
!tests/avd/**/evidence/*.log
!tests/avd/**/evidence/*.log.*
