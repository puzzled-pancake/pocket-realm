<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Offline flavor: foreground service + notifications, plus INTERNET.
         INTERNET is required by schemas/flavor.json android_permissions.required
         and the report: app-local TCP sockets and the versioned app-private
         control channel need loopback. network_policy (flavor.json) is explicit:
         INTERNET permits app-local TCP only; offline realm listeners bind to
         127.0.0.1 and the permission authorizes no external gameplay authority
         (connected transport is post-O22, separate flavor/build type). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketRealm"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PocketRealm">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.RealmService"
            android:process=":supervisor"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Hosts a long-running local game realm server (offline PvE) that must persist across multi-hour play sessions for the duration the user is playing." />
        </service>

        <receiver
            android:name=".service.SaveExitReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.pocketrealm.action.SAVE_EXIT" />
            </intent-filter>
        </receiver>

        <!-- O05 PKG-02: an isolated fault domain for the native crash experiment.
             The deliberate abort() happens here, never in :main. Not a bound
             service from the UI's perspective; the runner attaches a Binder
             DeathRecipient to observe child death. Exported=false, no FGS. -->
        <service
            android:name=".pkg.PkgIsolationService"
            android:process=":pkg"
            android:exported="false" />

        <!-- O06: Wine and every native child live in a dedicated fault domain.
             Only the same APK can bind; the token-scoped AIDL surface never
             accepts an arbitrary executable, prefix path, or environment. -->
        <service
            android:name=".client.ClientRuntimeService"
            android:process=":client"
            android:exported="false" />

        <!-- O08: MariaDB owns its datadir in a dedicated fault domain. The
             same-APK Binder API exposes lifecycle/test verbs only; callers
             cannot submit SQL, paths, commands, environment, or credentials. -->
        <service
            android:name=".database.DatabaseService"
            android:process=":database"
            android:exported="false" />

        <!-- O09: CMaNGOS components are library-backed but retain executable-
             equivalent failure boundaries. The fixed AIDL APIs accept no
             paths, SQL, environment, or arbitrary server commands. -->
        <service
            android:name=".server.RealmRuntimeService"
            android:process=":realm"
            android:exported="false" />
        <service
            android:name=".server.WorldRuntimeService"
            android:process=":world"
            android:exported="false" />
    </application>
</manifest>
