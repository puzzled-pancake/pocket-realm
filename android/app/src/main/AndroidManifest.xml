<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Offline flavor: foreground service + notifications only. No gameplay
         INTERNET permission. See schemas/flavor.json excludes_from_release_artifact.
         The realm uses FGS type specialUse, NOT dataSync: dataSync is capped at
         6h on Android 15 and is intended for finite syncs, whereas the realm is
         a persistent long-running process spanning multi-hour play sessions. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketRealm"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PocketRealm">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.RealmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Hosts a long-running local game realm server (offline PvE) that must persist across multi-hour play sessions for the duration the user is playing." />
        </service>

        <receiver
            android:name=".service.SaveExitReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.pocketrealm.action.SAVE_EXIT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
