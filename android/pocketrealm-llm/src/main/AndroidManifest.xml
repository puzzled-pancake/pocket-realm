<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Runs in its own process: a runtime crash or OOM here never takes
             down the main app or the Wine container. Supervisor starts/stops
             it explicitly (see LlmRuntime.kt). -->
        <service
            android:name="com.pocketrealm.llm.LlmRuntimeService"
            android:process=":llm"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
