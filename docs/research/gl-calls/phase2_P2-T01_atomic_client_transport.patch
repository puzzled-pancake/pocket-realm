+#ifdef POLLRDHUP
+    requestedEvents |= POLLRDHUP;
+#endif
+    struct pollfd peer = {
+        .fd = ring->peerFd,
+        .events = requestedEvents,
+        .revents = 0,
+    };
+    int result;
+    do {
+        result = poll(&peer, 1, (int)((sleepUs + 999u) / 1000u));
+    }
+    while (result < 0 && errno == EINTR);
