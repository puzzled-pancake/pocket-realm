+    if (shift > 4u) shift = 4u;
+    uint32_t sleepUs = RING_WAIT_INITIAL_SLEEP_US << shift;
+    if (sleepUs > RING_WAIT_MAX_SLEEP_US) sleepUs = RING_WAIT_MAX_SLEEP_US;
