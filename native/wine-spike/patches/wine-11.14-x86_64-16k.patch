diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 68a4afa..649d84b 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -550,7 +550,7 @@ static pthread_mutex_t instrumentation_callback_mutex = PTHREAD_MUTEX_INITIALIZE
 
 void set_process_instrumentation_callback( void *callback )
 {
-    void *ptr = (char *)user_shared_data + page_size;
+    void *ptr = (void *)0x7ffe4000;
     sigset_t sigset;
     void *old;
 
@@ -2788,16 +2788,21 @@ void signal_init_process( TEB *teb )
 {
     struct sigaction sig_act;
     WOW_TEB *wow_teb = get_wow_teb( teb );
+    const UINT_PTR host_page_size = get_host_page_size();
     void *ptr;
 
     if (user_shared_data->XState.Size) xstate_size = user_shared_data->XState.Size - sizeof(XSAVE_FORMAT);
     frame_size = offsetof( struct syscall_frame, xstate ) + xstate_size;
     xstate_extended_features = user_shared_data->XState.EnabledFeatures & ~(UINT64)3;
 
-    /* sneak in a syscall dispatcher pointer at a fixed address (7ffe1000) */
-    ptr = (char *)user_shared_data + page_size;
-    anon_mmap_fixed( ptr, page_size, PROT_READ | PROT_WRITE, 0 );
+    /* Keep the process-local syscall dispatcher outside the host page that
+     * contains KUSER_SHARED_DATA.  On a 16K host, 0x7ffe1000 is part of the
+     * same MAP_SHARED page as 0x7ffe0000; storing an ASLR-relative function
+     * pointer there lets processes overwrite one another's dispatcher. */
+    ptr = (void *)0x7ffe4000;
+    anon_mmap_fixed( ptr, host_page_size, PROT_READ | PROT_WRITE, 0 );
     *(void **)ptr = __wine_syscall_dispatcher;
+    mprotect( ptr, host_page_size, PROT_READ );
 
     __asm__( "movw %%cs,%0" : "=m" (cs64_sel) );
     __asm__( "movw %%ss,%0" : "=m" (ds64_sel) );
