+         * truncated when the WoW64 process consumes the returned pointer.
+         * Keep the fallback representable by the 32-bit guest. */
+        if (addr == MAP_FAILED)
+            return map_view( view, NULL, dosmem_size, 0, vprot,
+                             0, limit_4g - 1, 0 );
     }
 
     /* now try to allocate the low 64K too */
@@ -3670,7 +3670,7 @@ void virtual_init(void)
     pthread_mutex_init( &virtual_mutex, &attr );
     pthread_mutexattr_destroy( &attr );
 
-#ifdef __aarch64__
+#if defined(__aarch64__) || defined(__x86_64__)
     host_page_size = sysconf( _SC_PAGESIZE );
     host_page_mask = host_page_size - 1;
     TRACE( "host page size: %uk\n", (UINT)host_page_size / 1024 );
@@ -4465,14 +4465,25 @@ void virtual_map_user_shared_data(void)
     unsigned int status;
     HANDLE section;
     int res, fd, needs_close;
+    size_t map_size = page_size;
+    int prot = PROT_READ;
 
     if ((status = NtOpenSection( &section, SECTION_ALL_ACCESS, &attr )))
     {
         ERR( "failed to open the USD section: %08x\n", status );
         exit(1);
     }
-    if ((res = server_get_unix_fd( section, 0, &fd, &needs_close, NULL, NULL )) ||
-        (user_shared_data != mmap( user_shared_data, page_size, PROT_READ, MAP_SHARED|MAP_FIXED, fd, 0 )))
+    if (!(res = server_get_unix_fd( section, 0, &fd, &needs_close, NULL, NULL )) &&
+        host_page_size > page_size)
+    {
+        /* A 16K host must map a complete host page at 0x7ffe0000.  Extend the
+         * shared backing file accordingly; the process-local syscall
+         * dispatcher is kept on a separate page at 0x7ffe4000. */
+        if (ftruncate( fd, host_page_size )) res = errno;
+        else map_size = host_page_size;
+    }
+    if (res ||
+        (user_shared_data != mmap( user_shared_data, map_size, prot, MAP_SHARED|MAP_FIXED, fd, 0 )))
     {
         ERR( "failed to remap the process USD: %d\n", res );
         exit(1);
