      "backends": [
        "mysql",
        "sqlite"
      ],
      "path": "src/game/Maps/GridMap.cpp",
      "reason": "Do not enter MMapManager::loadMap when mmap.enabled=0; the disabled manager intentionally has no map instance."
    },
    {
      "id": "mmap-loadmap-graceful-miss",
      "backends": [
        "mysql",
        "sqlite"
      ],
