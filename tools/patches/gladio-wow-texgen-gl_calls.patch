+static void gladio_unimplemented(const char* name) {
+    static const char* logged[256];
+    static int loggedCount = 0;
+    static pthread_mutex_t mutex = PTHREAD_MUTEX_INITIALIZER;
+    pthread_mutex_lock(&mutex);
+    for (int i = 0; i < loggedCount; i++) {
+        if (logged[i] == name) {
+            pthread_mutex_unlock(&mutex);
+            return;
+        }
+    }
+    if (loggedCount < 256) logged[loggedCount++] = name;
+    pthread_mutex_unlock(&mutex);
+    println(MSG_DEBUG_UNIMPLEMENTED_GLCALL, name);
+}
